# Copy to .env.local. Never commit secrets or configure live email without approval.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false until branding, corporate information, and legal policies are reviewed.
SITE_INDEXING_ENABLED=false
# disabled (default) | preview (validate only; no storage/email) | live
INQUIRY_DELIVERY=disabled
# Required only for live email; verified sender and an owner-approved recipient.
RESEND_API_KEY=
INQUIRY_FROM=
INQUIRY_TO=
# Live mode requires distributed rate limiting. Obtain your own service credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret of at least 32 characters to HMAC rate-limit identifiers.
RATE_LIMIT_SECRET=
