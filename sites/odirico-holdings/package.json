{
  "name": "odirico-holdings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json README.md docs/*.md",
    "assets": "node scripts/prepare-ownership-assets.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "geist": "1.7.2",
    "lucide-react": "1.48.0",
    "motion": "13.4.6",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "resend": "6.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
